---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteConfig';
---

<BaseLayout title={`我的项目 · ${siteConfig.title}`} description="全栈开发项目、效率小工具与业余折腾作品集">
  <div class="cyber-container">
    <header class="cyber-panel lab-hero">
      <div class="lab-top">
        <span class="cyber-badge cyber-badge-yellow">作品集 · 全栈开发与工具</span>
        <span class="cluster-status">共收录 {siteConfig.projects.length} 个项目</span>
      </div>
      <h1 class="lab-title">我的项目与小工具</h1>
      <p class="lab-desc">
        这里记录了我平时开发的全栈项目、提升日常工作效率的 AI 命令行小工具，以及周末业余时间折腾的开源配置。
      </p>
    </header>

    <div class="projects-grid">
      {siteConfig.projects.map((proj) => (
        <article class="cyber-panel project-card">
          <div class="proj-header">
            <div>
              <span class="proj-codename">#{proj.id} · {proj.tag}</span>
              <h2 class="proj-name">{proj.name}</h2>
            </div>
            <span
              class:list={[
                'cyber-badge',
                proj.status === '已上线' ? '' : proj.status === '维护中' ? 'cyber-badge-pink' : 'cyber-badge-yellow',
              ]}
            >
              {proj.status}
            </span>
          </div>

          <p class="proj-desc">{proj.description}</p>

          <div class="proj-metrics-bar">
            <span class="metrics-prefix">项目亮点：</span>
            <strong>{proj.highlight}</strong>
          </div>

          <div class="proj-stack">
            {proj.techStack.map((tech) => (
              <span class="stack-chip">{tech}</span>
            ))}
          </div>

          <div class="proj-actions">
            <a href={proj.repoUrl} target="_blank" rel="noopener noreferrer" class="cyber-btn">
              <span>⬡ GitHub 源码</span>
            </a>
            {proj.demoUrl && (
              <a href={proj.demoUrl} target="_blank" rel="noopener noreferrer" class="cyber-btn cyber-btn-pink">
                <span>⚡ 在线预览</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .lab-hero {
    padding: 2rem 2.25rem;
    margin-bottom: 2.25rem;
  }

  .lab-top {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 0.85rem;
  }

  .cluster-status {
    color: var(--neon-green);
  }

  .lab-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.3rem);
    font-weight: 900;
    color: #fff;
    margin-bottom: 0.6rem;
  }

  .lab-desc {
    color: var(--text-secondary);
    max-width: 780px;
    line-height: 1.7;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .project-card {
    padding: 1.65rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.1rem;
  }

  .proj-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .proj-codename {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--neon-pink);
    letter-spacing: 0.04em;
  }

  .proj-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--text-heading);
    margin-top: 0.25rem;
  }

  .proj-desc {
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .proj-metrics-bar {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.55rem 0.85rem;
    background: var(--bg-inset);
    border-left: 3px solid var(--neon-cyan);
    border-radius: 0 6px 6px 0;
    color: var(--text-primary);
  }

  .metrics-prefix {
    color: var(--neon-cyan);
    margin-right: 0.25rem;
  }

  .proj-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .stack-chip {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.2rem 0.58rem;
    background: var(--bg-chip);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    color: var(--text-secondary);
  }

  .proj-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
