---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteConfig';
---

<BaseLayout title={`关于我 · ${siteConfig.title}`} description="全栈开发者个人简介、常用技术栈与经历">
  <div class="cyber-container">
    <!-- Developer Profile Card -->
    <section class="cyber-panel profile-hero">
      <div class="profile-grid">
        <div class="avatar-holo">
          <div class="holo-frame">
            <span class="holo-code">&lt;{siteConfig.author.avatarText}/&gt;</span>
            <div class="holo-scanline"></div>
          </div>
          <span class="cyber-badge cyber-badge-pink">{siteConfig.author.handle}</span>
        </div>

        <div class="profile-info">
          <div class="handle-row">
            <span class="status-dot"></span>
            <span class="handle-text">{siteConfig.author.status}</span>
          </div>
          <h1 class="author-name">你好，我是 {siteConfig.author.name}</h1>
          <p class="author-role">{siteConfig.author.role}</p>
          <p class="author-bio">{siteConfig.author.bio}</p>

          <div class="contact-links">
            <a href={siteConfig.author.github} target="_blank" rel="noopener noreferrer" class="cyber-btn">
              GitHub 主页
            </a>
            <a href={`mailto:${siteConfig.author.email}`} class="cyber-btn cyber-btn-pink">
              发送邮件 ({siteConfig.author.email})
            </a>
            <a href="/rss.xml" class="cyber-btn">
              RSS 订阅
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="about-dual-grid">
      <!-- Tech Stack Matrix -->
      <section class="hud-box spec-panel">
        <div class="section-header">
          <h2 class="section-title">
            <span class="prefix">01</span>
            <span>常用技术栈与工具</span>
          </h2>
        </div>

        <div class="skills-list">
          {siteConfig.skills.map((skill) => (
            <div class="skill-item">
              <div class="skill-meta">
                <span class="skill-name">{skill.name}</span>
                <span class="skill-cat">{skill.category} · {skill.level}%</span>
              </div>
              <div class="skill-track">
                <div class="skill-fill" style={`width: ${skill.level}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Timeline -->
      <section class="hud-box spec-panel">
        <div class="section-header">
          <h2 class="section-title">
            <span class="prefix">02</span>
            <span>开发经历与折腾足迹</span>
          </h2>
        </div>

        <div class="timeline-list">
          {siteConfig.timeline.map((item) => (
            <div class="timeline-node">
              <div class="node-year">{item.year} · {item.org}</div>
              <h3 class="node-title">{item.title}</h3>
              <p class="node-desc">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .profile-hero {
    padding: 2.25rem;
    margin-bottom: 2.5rem;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2.25rem;
    align-items: center;
  }

  .avatar-holo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .holo-frame {
    position: relative;
    width: 160px;
    height: 160px;
    border: 2px solid var(--neon-cyan);
    border-radius: 16px;
    background: radial-gradient(circle, var(--neon-cyan-dim), var(--bg-inset));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 0 8px 25px var(--neon-cyan-dim);
  }

  .holo-code {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.55rem;
    color: var(--neon-cyan);
    letter-spacing: 0.04em;
    text-shadow: 0 0 12px var(--neon-cyan);
  }

  .holo-scanline {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 40%, rgba(255, 0, 85, 0.35) 50%, transparent 60%);
    background-size: 100% 30px;
    animation: scan-move 3s linear infinite;
  }

  @keyframes scan-move {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }

  .handle-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--neon-green);
    margin-bottom: 0.4rem;
  }

  .author-name {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 900;
    color: #fff;
    margin-bottom: 0.25rem;
  }

  .author-role {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--neon-cyan);
    margin-bottom: 1rem;
  }

  .author-bio {
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 680px;
    margin-bottom: 1.4rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .about-dual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .spec-panel {
    padding: 1.75rem;
  }

  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .skill-meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin-bottom: 0.35rem;
  }

  .skill-name {
    color: #fff;
    font-weight: 700;
  }

  .skill-cat {
    color: var(--neon-cyan);
  }

  .skill-track {
    height: 7px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(0, 243, 255, 0.2);
  }

  .skill-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--neon-cyan), var(--neon-pink));
    box-shadow: 0 0 10px var(--neon-cyan-glow);
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    border-left: 2px solid rgba(0, 243, 255, 0.3);
    padding-left: 1.25rem;
  }

  .timeline-node {
    position: relative;
  }

  .timeline-node::before {
    content: '';
    position: absolute;
    left: -1.62rem;
    top: 0.25rem;
    width: 10px;
    height: 10px;
    background: var(--neon-pink);
    box-shadow: 0 0 8px var(--neon-pink);
  }

  .node-year {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--neon-yellow);
    margin-bottom: 0.2rem;
  }

  .node-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: #fff;
    margin-bottom: 0.35rem;
  }

  .node-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .profile-grid,
    .about-dual-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
