---
import type { CollectionEntry } from 'astro:content';
import { categoryLabels } from '../data/siteConfig';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, category, tags, aiSummary, confidence, readingTime, serialCode } = post.data;

const formattedDate = pubDate.toISOString().split('T')[0];

const categoryColorMap: Record<string, string> = {
  AI_AGENT: 'cyber-badge-pink',
  LLM_ARCH: 'cyber-badge',
  CYBER_UI: 'cyber-badge-yellow',
  EDGE_COMPUTE: 'cyber-badge',
  NEURAL_THOUGHTS: 'cyber-badge-pink',
};
---

<article class:list={['cyber-panel post-card', { 'is-featured': featured }]}>
  <div class="card-top-bar">
    <div class="meta-left">
      <span class="serial-code">{serialCode}</span>
      <span class:list={['cyber-badge', categoryColorMap[category] || '']}>
        {categoryLabels[category] || category}
      </span>
    </div>
    <div class="meta-right">
      <span class="confidence-pill" title="AI 神经置信度评分">
        同步率 {confidence}%
      </span>
      <time datetime={pubDate.toISOString()} class="post-date">{formattedDate}</time>
    </div>
  </div>

  <a href={`/blog/${post.id}`} class="card-title-link">
    <h3 class="card-title">{title}</h3>
  </a>

  <p class="card-desc">{description}</p>

  <div class="ai-snippet">
    <span class="ai-snippet-label">AI 摘要：</span>
    <span class="ai-snippet-text">{aiSummary}</span>
  </div>

  <div class="card-footer">
    <div class="tag-list">
      {tags.slice(0, 4).map((tag) => (
        <span class="tag-chip">#{tag}</span>
      ))}
    </div>

    <a href={`/blog/${post.id}`} class="read-more-link">
      <span>阅读全文 ({readingTime.replace('MIN', '分钟')})</span>
      <span class="arrow">→</span>
    </a>
  </div>
</article>

<style>
  .post-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.9rem;
    transition: all 0.25s ease;
  }

  .post-card:hover {
    transform: translateY(-4px);
    border-color: var(--neon-cyan);
  }

  .post-card.is-featured {
    border-left: 3px solid var(--neon-pink);
    background: linear-gradient(135deg, rgba(255, 0, 85, 0.06) 0%, rgba(12, 17, 29, 0.88) 45%);
  }

  .card-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .meta-left,
  .meta-right {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .serial-code {
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .confidence-pill {
    color: var(--neon-green);
    background: rgba(0, 255, 157, 0.08);
    border: 1px solid rgba(0, 255, 157, 0.28);
    padding: 0.1rem 0.45rem;
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .post-date {
    color: var(--text-secondary);
  }

  .card-title-link {
    text-decoration: none;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.4;
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .post-card:hover .card-title {
    color: var(--neon-cyan);
    text-shadow: 0 0 12px rgba(0, 243, 255, 0.3);
  }

  .card-desc {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .ai-snippet {
    background: rgba(0, 243, 255, 0.04);
    border-left: 2px solid var(--neon-cyan);
    padding: 0.65rem 0.85rem;
    font-size: 0.82rem;
    color: #cbd5e1;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-snippet-label {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--neon-cyan);
    margin-right: 0.25rem;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.08);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--neon-cyan);
    text-decoration: none;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .read-more-link .arrow {
    transition: transform 0.2s ease;
  }

  .post-card:hover .read-more-link .arrow {
    transform: translateX(4px);
    color: var(--neon-pink);
  }
</style>
