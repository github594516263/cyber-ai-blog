---
import { siteConfig } from '../data/siteConfig';

const pathname = Astro.url.pathname;
const navItems = [
  { num: '01', label: '首页', href: '/' },
  { num: '02', label: '文章归档', href: '/blog' },
  { num: '03', label: 'AI 实验室', href: '/projects' },
  { num: '04', label: '个人档案', href: '/about' },
];
---

<header class="cyber-header">
  <div class="cyber-container header-inner">
    <a href="/" class="brand-logo" aria-label="返回首页">
      <div class="brand-icon">
        <span class="brand-core">⚡ AI</span>
      </div>
      <div class="brand-text">
        <span class="brand-title">{siteConfig.title}</span>
        <span class="brand-sub">NEURAL DECK · 2077</span>
      </div>
    </a>

    <nav class="cyber-nav" aria-label="主导航">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a href={item.href} class:list={['nav-link', { active: isActive }]}>
            <span class="nav-num">{item.num}</span>
            <span>{item.label}</span>
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <button id="open-terminal-btn" class="terminal-trigger" type="button" title="唤醒神经终端 (Ctrl+K)">
        <span class="status-dot"></span>
        <span class="trigger-text">AI 终端</span>
        <kbd class="trigger-kbd">⌘K</kbd>
      </button>

      <button id="toggle-theme-btn" class="hud-icon-btn" type="button" title="切换赛博青/矩阵绿主题">
        <span id="theme-label">赛博青</span>
      </button>

      <button id="toggle-crt-btn" class="hud-icon-btn" type="button" title="开关 CRT 扫描线滤镜">
        <span>扫描线</span>
      </button>
    </div>
  </div>
</header>

<style>
  .cyber-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(6, 7, 11, 0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(0, 243, 255, 0.22);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 1.25rem;
    flex-wrap: nowrap;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .brand-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--neon-cyan);
    background: rgba(0, 243, 255, 0.1);
    border: 1px solid rgba(0, 243, 255, 0.4);
    padding: 0.35rem 0.65rem;
    text-shadow: 0 0 10px var(--neon-cyan-glow);
    white-space: nowrap;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    white-space: nowrap;
  }

  .brand-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    color: #fff;
    line-height: 1.2;
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .cyber-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.45rem 0.9rem;
    border: 1px solid transparent;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-num {
    font-size: 0.72rem;
    color: var(--neon-pink);
    opacity: 0.85;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--neon-cyan);
    background: rgba(0, 243, 255, 0.08);
    border-color: rgba(0, 243, 255, 0.3);
    text-shadow: 0 0 8px var(--neon-cyan-glow);
  }

  .nav-link.active {
    border-bottom: 2px solid var(--neon-pink);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .terminal-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255, 0, 85, 0.1);
    border: 1px solid rgba(255, 0, 85, 0.45);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.4rem 0.75rem;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .terminal-trigger:hover {
    background: rgba(255, 0, 85, 0.22);
    border-color: var(--neon-pink);
    box-shadow: 0 0 14px var(--neon-pink-glow);
  }

  .trigger-kbd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.1rem 0.35rem;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--neon-yellow);
    border-radius: 2px;
  }

  .hud-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 243, 255, 0.06);
    border: 1px solid rgba(0, 243, 255, 0.25);
    color: var(--neon-cyan);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .hud-icon-btn:hover {
    background: var(--neon-cyan);
    color: #05070c;
  }

  @media (max-width: 900px) {
    .header-inner {
      flex-wrap: wrap;
      height: auto;
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
      gap: 0.65rem;
    }
    .cyber-nav {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      overflow-x: auto;
      padding-top: 0.5rem;
      border-top: 1px solid rgba(0, 243, 255, 0.12);
    }
  }
</style>

<script>
  const crtBtn = document.getElementById('toggle-crt-btn');
  const themeBtn = document.getElementById('toggle-theme-btn');
  const themeLabel = document.getElementById('theme-label');

  if (localStorage.getItem('cyber-crt') === 'off') {
    document.body.classList.add('crt-off');
  }
  if (localStorage.getItem('cyber-theme') === 'matrix') {
    document.body.classList.add('theme-matrix');
    if (themeLabel) themeLabel.textContent = '矩阵绿';
  }

  crtBtn?.addEventListener('click', () => {
    document.body.classList.toggle('crt-off');
    const isOff = document.body.classList.contains('crt-off');
    localStorage.setItem('cyber-crt', isOff ? 'off' : 'on');
  });

  themeBtn?.addEventListener('click', () => {
    document.body.classList.toggle('theme-matrix');
    const isMatrix = document.body.classList.contains('theme-matrix');
    localStorage.setItem('cyber-theme', isMatrix ? 'matrix' : 'cyber');
    if (themeLabel) themeLabel.textContent = isMatrix ? '矩阵绿' : '赛博青';
  });
</script>
