---
import { siteConfig } from '../data/siteConfig';

const pathname = Astro.url.pathname;
const navItems = [
  { num: '01', label: '首页', href: '/' },
  { num: '02', label: '文章归档', href: '/blog' },
  { num: '03', label: '我的项目', href: '/projects' },
  { num: '04', label: '关于我', href: '/about' },
];
---

<header class="cyber-header">
  <div class="cyber-container header-inner">
    <a href="/" class="brand-logo" aria-label="返回首页">
      <div class="brand-icon">
        <span class="brand-core">&lt;/&gt;</span>
      </div>
      <div class="brand-text">
        <span class="brand-title">{siteConfig.title}</span>
        <span class="brand-sub">{siteConfig.subtitle}</span>
      </div>
    </a>

    <nav class="cyber-nav" aria-label="主导航">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a href={item.href} class:list={['nav-link', { active: isActive }]}>
            <span class="nav-num">{item.num}</span>
            <span>{item.label}</span>
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <button id="open-terminal-btn" class="terminal-trigger" type="button" title="打开快捷搜索面板 (Ctrl+K)">
        <span class="status-dot"></span>
        <span class="trigger-text">快捷搜索</span>
        <kbd class="trigger-kbd">⌘K</kbd>
      </button>

      <!-- 主题下拉选择器 -->
      <div class="theme-dropdown" id="theme-dropdown">
        <button
          id="theme-dropdown-trigger"
          class="hud-icon-btn theme-trigger-btn"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          title="选择主题风格"
        >
          <span id="theme-swatch-current" class="swatch swatch-cyber"></span>
          <span id="theme-label">赛博青</span>
          <span class="dropdown-caret">▾</span>
        </button>

        <div id="theme-dropdown-menu" class="theme-dropdown-menu hidden" role="menu">
          <button type="button" class="theme-option" data-theme="cyber" role="menuitem">
            <span class="swatch swatch-cyber"></span>
            <span class="opt-text">赛博青</span>
            <span class="opt-desc">暗黑霓虹</span>
          </button>
          <button type="button" class="theme-option" data-theme="matrix" role="menuitem">
            <span class="swatch swatch-matrix"></span>
            <span class="opt-text">矩阵绿</span>
            <span class="opt-desc">黑客帝国</span>
          </button>
          <button type="button" class="theme-option" data-theme="daylight" role="menuitem">
            <span class="swatch swatch-daylight"></span>
            <span class="opt-text">白昼赛博</span>
            <span class="opt-desc">洁净表面</span>
          </button>
        </div>
      </div>

      <button id="toggle-crt-btn" class="hud-icon-btn" type="button" title="开关 CRT 扫描线滤镜">
        <span>扫描线</span>
      </button>
    </div>
  </div>
</header>

<style>
  .cyber-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(8, 11, 18, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(0, 243, 255, 0.14);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 1.25rem;
    flex-wrap: nowrap;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .brand-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--neon-cyan);
    background: var(--neon-cyan-dim);
    border: 1px solid rgba(0, 243, 255, 0.3);
    border-radius: 8px;
    padding: 0.38rem 0.65rem;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .brand-logo:hover .brand-icon {
    border-color: var(--neon-cyan);
    box-shadow: 0 0 12px var(--neon-cyan-dim);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    white-space: nowrap;
  }

  .brand-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.08rem;
    letter-spacing: 0.03em;
    color: var(--text-heading);
    line-height: 1.2;
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  /* 导航菜单：去除生硬的四周边框，采用柔和胶囊底色 + 底部流光指示条 */
  .cyber-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.48rem 0.95rem;
    border-radius: 6px;
    transition: color 0.2s ease, background-color 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-num {
    font-size: 0.72rem;
    color: var(--neon-pink);
    opacity: 0.8;
    font-weight: 600;
  }

  .nav-link:hover {
    color: var(--text-heading);
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-link.active {
    color: var(--neon-cyan);
    background: var(--neon-cyan-dim);
    font-weight: 600;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--neon-cyan), var(--neon-pink));
  }

  /* 右侧工具按钮组 */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .terminal-trigger {
    display: inline-flex;
    align-items: center;
    height: 36px;
    gap: 0.45rem;
    background: rgba(255, 0, 85, 0.08);
    border: 1px solid rgba(255, 0, 85, 0.3);
    border-radius: 6px;
    color: var(--text-heading);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0 0.75rem;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .terminal-trigger:hover {
    background: rgba(255, 0, 85, 0.15);
    border-color: var(--neon-pink);
    box-shadow: 0 4px 12px var(--neon-pink-dim);
  }

  .trigger-kbd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.08rem 0.35rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--neon-yellow);
    border-radius: 4px;
  }

  .hud-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(0, 243, 255, 0.2);
    border-radius: 6px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0 0.75rem;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .hud-icon-btn:hover {
    border-color: var(--neon-cyan);
    background: var(--neon-cyan-dim);
    color: var(--neon-cyan);
  }

  /* 主题下拉菜单：精致悬浮毛玻璃卡片 */
  .theme-dropdown {
    position: relative;
  }

  .dropdown-caret {
    font-size: 0.7rem;
    opacity: 0.65;
    transition: transform 0.2s ease;
  }

  .theme-dropdown.open .dropdown-caret {
    transform: rotate(180deg);
  }

  .theme-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 190px;
    background: rgba(12, 16, 28, 0.95);
    border: 1px solid rgba(0, 243, 255, 0.22);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    padding: 0.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    z-index: 200;
    backdrop-filter: blur(16px);
  }

  .theme-dropdown-menu.hidden {
    display: none;
  }

  .theme-option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.55rem 0.7rem;
    background: transparent;
    border: none;
    border-radius: 6px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-align: left;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .theme-option:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--neon-cyan);
  }

  .theme-option.active {
    background: var(--neon-cyan-dim);
    color: var(--neon-cyan);
    font-weight: 600;
  }

  .opt-text {
    flex: 1;
  }

  .opt-desc {
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .swatch-cyber {
    background: #00f3ff;
    box-shadow: 0 0 8px rgba(0, 243, 255, 0.7);
  }

  .swatch-matrix {
    background: #00ff9d;
    box-shadow: 0 0 8px rgba(0, 255, 157, 0.7);
  }

  .swatch-daylight {
    background: #007A87;
    box-shadow: inset 0 0 0 2px #ffffff, 0 0 0 1px #007A87;
  }

  @media (max-width: 900px) {
    .header-inner {
      flex-wrap: wrap;
      height: auto;
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
      gap: 0.65rem;
    }
    .cyber-nav {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      overflow-x: auto;
      padding-top: 0.5rem;
      border-top: 1px solid rgba(0, 243, 255, 0.12);
    }
  }
</style>

<script>
  const crtBtn = document.getElementById('toggle-crt-btn');
  const dropdown = document.getElementById('theme-dropdown');
  const triggerBtn = document.getElementById('theme-dropdown-trigger');
  const menu = document.getElementById('theme-dropdown-menu');
  const themeLabel = document.getElementById('theme-label');
  const themeSwatchCurrent = document.getElementById('theme-swatch-current');
  const optionBtns = document.querySelectorAll('.theme-option');

  const themes = [
    { id: 'cyber', label: '赛博青', className: '', swatchClass: 'swatch-cyber' },
    { id: 'matrix', label: '矩阵绿', className: 'theme-matrix', swatchClass: 'swatch-matrix' },
    { id: 'daylight', label: '白昼赛博', className: 'theme-daylight', swatchClass: 'swatch-daylight' },
  ];

  function applyTheme(themeId: string) {
    const root = document.documentElement;
    root.classList.remove('theme-matrix', 'theme-daylight');
    const found = themes.find((t) => t.id === themeId) || themes[0];
    if (found.className) {
      root.classList.add(found.className);
    }
    if (themeLabel) {
      themeLabel.textContent = found.label;
    }
    if (themeSwatchCurrent) {
      themeSwatchCurrent.className = `swatch ${found.swatchClass}`;
    }
    optionBtns.forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-theme') === found.id);
    });
    localStorage.setItem('cyber-theme', found.id);
  }

  (window as any).__cycleCyberTheme = () => {
    const current = localStorage.getItem('cyber-theme') || 'cyber';
    const idx = themes.findIndex((t) => t.id === current);
    const next = themes[(idx + 1) % themes.length];
    applyTheme(next.id);
    return next.label;
  };

  const savedTheme = localStorage.getItem('cyber-theme') || 'cyber';
  applyTheme(savedTheme);

  function closeDropdown() {
    menu?.classList.add('hidden');
    dropdown?.classList.remove('open');
    triggerBtn?.setAttribute('aria-expanded', 'false');
  }

  triggerBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = menu?.classList.contains('hidden');
    if (isHidden) {
      menu?.classList.remove('hidden');
      dropdown?.classList.add('open');
      triggerBtn.setAttribute('aria-expanded', 'true');
    } else {
      closeDropdown();
    }
  });

  optionBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-theme') || 'cyber';
      applyTheme(selected);
      closeDropdown();
    });
  });

  document.addEventListener('click', (e) => {
    if (dropdown && !dropdown.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDropdown();
    }
  });

  crtBtn?.addEventListener('click', () => {
    const root = document.documentElement;
    root.classList.toggle('crt-off');
    const isOff = root.classList.contains('crt-off');
    localStorage.setItem('cyber-crt', isOff ? 'off' : 'on');
  });
</script>
